# Copy to .env for local development. NEVER commit real values.

APP_ENV=development                       # development | test | production
DATABASE_URL=sqlite:///./rs_agent.db      # production: postgresql://user:pass@host:5432/db
PUBLIC_BASE_URL=http://localhost:8000     # production: https://<your-service>.onrender.com

# Admin access (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
ADMIN_TOKEN=
SESSION_SECRET=

# Encrypts OAuth tokens at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# LinkedIn app (https://www.linkedin.com/developers/apps). Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_API_VERSION=202605               # YYYYMM; each version is supported >= 1 year — review quarterly
LINKEDIN_AUTO_PUBLISH=false               # keep false: every post goes through the approval queue

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_COMPLEX=claude-opus-5-5
CLAUDE_MODEL_SIMPLE=claude-haiku-5-5
# USD per million tokens — verify against current Anthropic pricing
CLAUDE_COMPLEX_INPUT_PER_MTOK=15
CLAUDE_COMPLEX_OUTPUT_PER_MTOK=75
CLAUDE_SIMPLE_INPUT_PER_MTOK=1
CLAUDE_SIMPLE_OUTPUT_PER_MTOK=5
DAILY_BUDGET_USD=2.00
MONTHLY_BUDGET_USD=40.00

# Operations
POSTS_PER_DAY=1                           # hard ceiling 2/day, 1/hour regardless of this value
JOB_MAX_ATTEMPTS=5
JOB_TIMEOUT_S=60
WORKER_POLL_S=5
